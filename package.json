{
  "name": "telcia",
  "version": "1.0.0",
  "description": "TELCIA (Telecom Cognitive Intelligent Agent) - Autonomous WhatsApp Collector, SQLite Queue & Wholesale Intelligence Terminal",
  "type": "module",
  "main": "backend/src/server.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
