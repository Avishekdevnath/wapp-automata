{
  "name": "wapp-automata",
  "version": "0.1.0",
  "description": "Native WhatsApp message collector and webhook dispatcher with local SQLite durable queue",
  "main": "backend/dist/index.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "start": "node backend/dist/index.js",
    "server": "node backend/src/server/index.js",
    "dev:collector": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:server": "npm run server:dev --prefix backend",
    "dashboard": "node backend/src/server/index.js",
    "deploy": "node scripts/deploy.js",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "whatsapp",
    "collector",
    "sqlite",
    "webhook"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.11.0",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^6.7.24",
    "better-sqlite3": "^13.0.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
